# Quarto
/.quarto/
/_book/
/_freeze/
/.cache/
*.html

# R
.Rproj.user
.Rhistory
.RData
.Ruserdata
*.Rproj
Rplots.pdf

# Data-raw intermediate files (keep scripts, ignore outputs)
data-raw/*.rds
data-raw/*.tmp
data-raw/*.Rdata

# System
.DS_Store
Thumbs.db
.Spotlight-V100
.Trashes

# Editor
*.swp
*.swo
*~
.vscode/
.idea/

# Temporary files
*.log
*.aux
*.out
*.toc
*.bbl
*.blg

# LaTeX
*.tex
*.pdf
!manuscript.pdf
# The PDF preamble is source, not LaTeX output; it must survive the rule above.
!styles/pdf-preamble.tex

# Written by tools/version.R before every render, from the git tag. Never
# edited by hand, never committed. (styles/version.tex is caught by *.tex.)
/_variables.yml

# Python (if used)
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Node (if used)
node_modules/
package-lock.json

# Manim intermediates. The rendered artefacts in assets/video/ ARE committed;
# manim's own working tree is not.
manim/media/
manim/__pycache__/
manim/ambook/__pycache__/
manim/venv/

**/*.quarto_ipynb

# knitr cache and figure directories, produced by `cache: true` in _quarto.yml.
# Generated output, never source.
*_cache/
*_files/
